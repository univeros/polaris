<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="module">
            <directory>tests</directory>
        </testsuite>
        <!-- polaris/core's functional suite and the contract freeze (184 recorded 1.0 fixtures). Without
             POLARIS_HARNESS they run through the bare PSR-15 pipeline; `composer test:contract` runs them
             through this module's Relay pipeline (tests/Harness.php). -->
        <testsuite name="functional">
            <directory>vendor/polaris/core/tests/Functional</directory>
            <directory>vendor/polaris/core/tests/Contract</directory>
        </testsuite>
        <!-- Every supported polaris plugin's own functional suite and recorded fixtures, replayed through
             this module (`composer test:plugins`). A plugin is supported when its suite is listed here. -->
        <testsuite name="plugins">
            <directory>vendor/polaris/passkey/tests/Functional</directory>
            <directory>vendor/polaris/username/tests/Functional</directory>
            <directory>vendor/polaris/social/tests/Functional</directory>
            <directory>vendor/polaris/passwordless/tests/Functional</directory>
            <directory>vendor/polaris/anonymous/tests/Functional</directory>
            <directory>vendor/polaris/multi-session/tests/Functional</directory>
            <directory>vendor/polaris/audit/tests/Functional</directory>
            <directory>vendor/polaris/admin/tests/Functional</directory>
            <directory>vendor/polaris/sentinel/tests/Functional</directory>
            <directory>vendor/polaris/sso/tests/Functional</directory>
            <directory>vendor/polaris/scim/tests/Functional</directory>
            <directory>vendor/polaris/api-keys/tests/Functional</directory>
            <directory>vendor/polaris/oauth-provider/tests/Functional</directory>
            <directory>vendor/polaris/mcp/tests/Functional</directory>
            <directory>vendor/polaris/agents/tests/Functional</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
