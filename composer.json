{
    "name": "univeros/polaris",
    "description": "Polaris for PHP as a Univeros module: authentication, MFA/OTP, organizations and RBAC on polaris/core.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["univeros", "altair", "polaris", "authentication", "mfa", "otp", "totp", "rbac", "users", "jwt"],
    "homepage": "https://univeros.io",
    "support": {
        "issues": "https://github.com/univeros/polaris/issues",
        "source": "https://github.com/univeros/polaris"
    },
    "require": {
        "php": ">=8.3",
        "laminas/laminas-diactoros": "^3.0",
        "polaris/cli": "^0.11",
        "polaris/core": "^0.11",
        "polaris/pdo": "^0.11",
        "polaris/psr15": "^0.11",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "univeros/cli": "^2.6",
        "univeros/container": "^2.6",
        "univeros/http": "^2.6",
        "univeros/module": "^2.6",
        "univeros/persistence": "^2.6"
    },
    "require-dev": {
        "httpsoft/http-message": "^1.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "polaris/admin": "^0.11",
        "polaris/agents": "^0.11",
        "polaris/anonymous": "^0.11",
        "polaris/api-keys": "^0.11",
        "polaris/audit": "^0.11",
        "polaris/mcp": "^0.11",
        "polaris/messaging": "^0.11",
        "polaris/multi-session": "^0.11",
        "polaris/oauth-provider": "^0.11",
        "polaris/passkey": "^0.11",
        "polaris/passwordless": "^0.11",
        "polaris/scim": "^0.11",
        "polaris/sentinel": "^0.11",
        "polaris/social": "^0.11",
        "polaris/sso": "^0.11",
        "polaris/testing": "^0.11",
        "polaris/username": "^0.11",
        "squizlabs/php_codesniffer": "^3.13.6",
        "symfony/event-dispatcher": "^7.0",
        "univeros/doctor": "^2.6",
        "univeros/introspection": "^2.6",
        "univeros/messaging": "^2.6",
        "univeros/observability": "^2.6"
    },
    "suggest": {
        "polaris/testing": "Univeros\\Polaris\\Testing\\PolarisTesting boots Polaris in memory for the application's tests",
        "univeros/agent-spec": "bin/altair manifest:generate writes the Polaris section of the AI-readable manifests",
        "univeros/doctor": "The Polaris checks (secrets and keys, plugins, schema) join bin/altair doctor",
        "univeros/introspection": "bin/altair routes:list shows the Polaris routes beside the application's",
        "univeros/messaging": "Univeros\\Polaris\\Messaging\\BusOutbox sends polaris/messaging's messages through the bus and its worker",
        "univeros/observability": "Polaris counts its domain events through the bound Meter"
    },
    "autoload": {
        "psr-4": {
            "Univeros\\Polaris\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Univeros\\Polaris\\Tests\\": "tests/",
            "Polaris\\Tests\\": "vendor/polaris/core/tests/",
            "Polaris\\Passkey\\Tests\\": "vendor/polaris/passkey/tests/",
            "Polaris\\Social\\Tests\\": "vendor/polaris/social/tests/",
            "Polaris\\Passwordless\\Tests\\": "vendor/polaris/passwordless/tests/",
            "Polaris\\Anonymous\\Tests\\": "vendor/polaris/anonymous/tests/",
            "Polaris\\MultiSession\\Tests\\": "vendor/polaris/multi-session/tests/",
            "Polaris\\Audit\\Tests\\": "vendor/polaris/audit/tests/",
            "Polaris\\Admin\\Tests\\": "vendor/polaris/admin/tests/",
            "Polaris\\Sentinel\\Tests\\": "vendor/polaris/sentinel/tests/",
            "Polaris\\Sso\\Tests\\": "vendor/polaris/sso/tests/",
            "Polaris\\Scim\\Tests\\": "vendor/polaris/scim/tests/",
            "Polaris\\ApiKeys\\Tests\\": "vendor/polaris/api-keys/tests/",
            "Polaris\\OAuth\\Tests\\": "vendor/polaris/oauth-provider/tests/",
            "Polaris\\Mcp\\Tests\\": "vendor/polaris/mcp/tests/",
            "Polaris\\Agents\\Tests\\": "vendor/polaris/agents/tests/",
            "Polaris\\Username\\Tests\\": "vendor/polaris/username/tests/"
        }
    },
    "scripts": {
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "stan": "phpstan analyse",
        "test": "phpunit",
        "test:contract": [
            "@putenv POLARIS_HARNESS=Univeros\\Polaris\\Tests\\Harness",
            "phpunit --testsuite functional"
        ],
        "test:plugins": [
            "@putenv POLARIS_HARNESS=Univeros\\Polaris\\Tests\\Harness",
            "phpunit --testsuite plugins"
        ],
        "qa": ["@cs", "@stan", "@test", "@test:contract", "@test:plugins"]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
