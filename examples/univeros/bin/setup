#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * One-time setup: .env with a generated APP_KEY and an RS256 key pair, then the schema through
 * `bin/altair db:migrate` (the module's Cycle migration), `polaris:schema:diff` and `polaris:doctor`
 * as the proof. Safe to run again.
 */

$root = dirname(__DIR__);
chdir($root);
@mkdir("$root/var/keys", 0700, true);

if (!is_file("$root/var/keys/private.pem")) {
    $key = openssl_pkey_new(['private_key_bits' => 2048, 'private_key_type' => OPENSSL_KEYTYPE_RSA]);
    if ($key === false || !openssl_pkey_export($key, $private)) {
        fwrite(STDERR, "openssl could not generate a key pair\n");
        exit(1);
    }
    file_put_contents("$root/var/keys/private.pem", $private);
    file_put_contents("$root/var/keys/public.pem", openssl_pkey_get_details($key)['key']);
    chmod("$root/var/keys/private.pem", 0600);
    echo "generated var/keys/{private,public}.pem\n";
}

if (!is_file("$root/.env")) {
    $env = (string) file_get_contents("$root/.env.example");
    $env = (string) preg_replace('/^APP_KEY=.*$/m', 'APP_KEY=' . bin2hex(random_bytes(24)), $env);
    // An absolute path: `php -S -t public` runs with public/ as its working directory.
    $env = (string) preg_replace('/^DB_DATABASE=.*$/m', 'DB_DATABASE=' . "$root/var/polaris.sqlite", $env);
    // phpdotenv reads a double-quoted value across lines, so the PEM files fit in .env as they are.
    $env .= "\nAUTH_JWT_PRIVATE_KEY=\"" . trim((string) file_get_contents("$root/var/keys/private.pem")) . "\"\n";
    $env .= "AUTH_JWT_PUBLIC_KEY=\"" . trim((string) file_get_contents("$root/var/keys/public.pem")) . "\"\n";
    file_put_contents("$root/.env", $env);
    echo "created .env\n";
}

foreach (['db:migrate', 'polaris:schema:diff', 'polaris:doctor'] as $command) {
    echo "\n$ bin/altair $command\n";
    passthru(PHP_BINARY . ' ' . escapeshellarg("$root/bin/altair") . ' ' . $command, $status);
    if ($status !== 0) {
        fwrite(STDERR, "bin/altair $command failed ($status)\n");
        exit($status);
    }
}
echo "\nNext: composer serve   then   bin/walkthrough.sh\n";
