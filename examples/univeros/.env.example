APP_ENV=dev
APP_DEBUG=true
# The framework's app key and Polaris's (at least 32 bytes); bin/setup fills it in.
APP_KEY=

# Logging (PSR-3 via Monolog).
LOG_CHANNEL=app
LOG_LEVEL=debug
LOG_PATH=php://stderr
LOG_FORMAT=line

# The database CycleOrmConfiguration and Polaris share; bin/setup makes the path absolute (the
# built-in server runs with public/ as its working directory).
DB_CONNECTION=sqlite
DB_DATABASE=var/polaris.sqlite

# Polaris: the token issuer and the RS256 key pair (bin/setup appends AUTH_JWT_PRIVATE_KEY and
# AUTH_JWT_PUBLIC_KEY as quoted multi-line values; var/keys/ keeps the PEM files).
AUTH_ISSUER=http://127.0.0.1:8080
AUTH_JWT_KID=demo-key-1
