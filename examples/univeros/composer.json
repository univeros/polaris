{
    "name": "univeros/polaris-example",
    "description": "univeros/polaris 2.0 demo: the Univeros skeleton with the Polaris module on SQLite",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true,
                "versions": {
                    "univeros/polaris": "2.0.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-pdo_sqlite": "*",
        "univeros/framework": "^2.5",
        "univeros/polaris": "2.0.x-dev"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8080 -t public"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
